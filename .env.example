APP_ENV=development
HTTP_PORT=8080
WEBSOCKET_PORT=8082
POSTGRES_USER=chatterstack
POSTGRES_PASSWORD=change_me
POSTGRES_DB=chatterstack
# Example DSN using the values above. Set `POSTGRES_DSN` directly to override.
POSTGRES_DSN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=1h
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_TTL=168h
